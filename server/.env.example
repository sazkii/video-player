# CMS 数据源配置
# 格式: CMS_SOURCE_名称=id|名称|API地址
# 例如: CMS_SOURCE_lziapi=lziapi|量子资源|https://cj.lziapi.com/api.php/provide/vod

# 示例配置（取消注释即可启用）：
# CMS_SOURCE_lziapi=lziapi|量子资源|https://cj.lziapi.com/api.php/provide/vod
# CMS_SOURCE_guangsuapi=guangsuapi|光速资源|https://api.guangsuapi.com/api.php/provide/vod
# CMS_SOURCE_hongniuzy2=hongniuzy2|红牛资源|https://www.hongniuzy2.com/api.php/provide/vod

# 服务端口
PORT=3000
